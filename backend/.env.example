DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord developer portal redirect URL (must be the backend callback).
DISCORD_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
DEVELOPMENT_GUILD_ID=584917332447592488

# Database
DATABASE_URL=postgres://postgres:password@postgres:5432/discord_bot

# Security
# At least 32 random characters; access JWTs are 15 minutes.
JWT_SECRET=
# Demo login is only supported outside NODE_ENV=production.
ENABLE_DEMO_LOGIN=false

# Optional privileged Discord intents; also enable these in the Discord Developer Portal.
# Member welcome events require GuildMembers. Word moderation requires MessageContent.
# Audit-based anti-nuke monitoring optionally uses GuildModeration and requires View Audit Log permission.
ENABLE_GUILD_MEMBERS_INTENT=false
ENABLE_MESSAGE_CONTENT_INTENT=false
ENABLE_GUILD_MODERATION_INTENT=false
# Separate kill switch: stay inactive even when Guild Moderation intent is enabled.
ENABLE_ANTI_NUKE_ALERTS=false

# OAuth redirects the browser here with a 2-minute, one-use code fragment.
# Set to your public frontend origin; the frontend proxies /api/v1 via Next.js.
FRONTEND_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Comma-separated allowed origins (defaults to FRONTEND_URL).
CORS_ORIGIN=
