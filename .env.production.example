# Copy this file to .env in the repository ROOT, not backend/.env.
# The production Compose file refuses to start if this variable is unset.
# Use a strong, unique password; never commit the filled .env file.
# POSTGRES_PASSWORD must match the password in backend/.env DATABASE_URL.
# Existing initialized database volumes do not change credentials when this
# value changes; migrate/rotate credentials explicitly before redeploying.
POSTGRES_PASSWORD=
