# Browser API calls stay on the frontend origin via the Next.js rewrite.
# BACKEND_API_URL is server-side only: origin without /api or /api/v1.
BACKEND_API_URL=http://localhost:3001

# Direct Discord OAuth and native player WebSocket origin, including /api/v1.
# Vercel production example: https://api.example.com/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001/api/v1

# Optional development-only demo button.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Dashboard tabs remain hidden until manually verified in a test Discord guild.
# Change each flag to true *only* after completing docs/release-readiness.md.
# NEXT_PUBLIC_* settings are compiled into the frontend; rebuild to change.
NEXT_PUBLIC_ENABLE_ECONOMY=false
NEXT_PUBLIC_ENABLE_GAMES=false
NEXT_PUBLIC_ENABLE_SETTINGS=false
